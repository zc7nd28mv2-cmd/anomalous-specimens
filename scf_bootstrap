#!/bin/bash
set -euo pipefail

export NODE_ENV=production
export PORT=9000
export HOSTNAME=0.0.0.0

if [ -x /var/lang/node20/bin/node ]; then
  NODE_BIN=/var/lang/node20/bin/node
elif [ -x /var/lang/node18/bin/node ]; then
  NODE_BIN=/var/lang/node18/bin/node
else
  NODE_BIN="$(command -v node)"
fi

exec "${NODE_BIN}" .next/standalone/server.js
